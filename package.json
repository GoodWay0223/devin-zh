{
  "name": "devin-desktop-zh",
  "version": "1.0.14",
  "description": "Devin 网页油猴、Windows Desktop 汉化与 macOS 检查预览工具",
  "private": true,
  "license": "MIT",
  "bin": {
    "devin-zh": "src/cli.js"
  },
  "scripts": {
    "start": "node scripts/launcher.js",
    "apply": "node src/cli.js apply",
    "prepare": "node src/cli.js prepare",
    "restore": "node src/cli.js restore",
    "status": "node src/cli.js status",
    "doctor": "node src/cli.js doctor",
    "translate": "node src/cli.js translate",
    "translate-strings": "node src/cli.js translate-strings",
    "strings": "node src/cli.js strings",
    "test": "node --test test/*.test.js",
    "build:userscript": "node web/build.js",
    "release:check": "node scripts/public-preflight.js",
    "build:release": "node scripts/build-release.js"
  },
  "dependencies": {
    "acorn": "8.16.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GoodWay0223/devin-zh.git"
  },
  "homepage": "https://github.com/GoodWay0223/devin-zh",
  "bugs": {
    "url": "https://github.com/GoodWay0223/devin-zh/issues"
  }
}
